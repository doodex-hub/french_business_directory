<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="mode">extension</field>
        <field name="priority" eval="17"/>
        <field name="arch" type="xml">
            <!-- 20.0: the form has a single `name` field in the header <h1> (19.0 had separate
                 id="company"/id="individual" fields). Keep the native field as-is ($0) and always
                 visible. Button: 19.0 used invisible="is_company != True"; in 20.0 is_company is
                 computed from the VAT (a company without VAT loses the button once saved), so
                 WORKAROUND approved by dev 2026-09-24: show it for every partner without parent
                 (commercial entity). FINDINGS.md MF-03 stays OPEN.
                 `$0` must be the whole text of its element (odoo/tools/template_inheritance.py),
                 hence the wrapper first, then the button placed after the field. -->
            <xpath expr="//h1/field[@name='name']" position="replace">
                <div style="display: flex; align-items: center;white-space:nowrap">$0</div>
            </xpath>
            <xpath expr="//h1/div/field[@name='name']" position="after">
                <button name="siret_wizard" type="object" class="oe_stat_button oe_highlight search-button prestaterre-search-button" string="Business Directory" icon="fa-search" invisible="parent_id" />
            </xpath>
        </field>
    </record>
</odoo>
